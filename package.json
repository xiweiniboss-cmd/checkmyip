{
  "name": "checkmyip",
  "version": "0.3.0",
  "private": true,
  "description": "checkmyip — IP 信息与纯净度检测（Cloudflare Worker + 静态资源）",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stamp-assets.mjs && wrangler dev --local",
    "deploy": "node scripts/stamp-assets.mjs && wrangler deploy",
    "build:assets": "node scripts/stamp-assets.mjs",
    "build:data": "node scripts/build-data.mjs",
    "db:migrate:local": "wrangler d1 migrations apply checkmyip --local",
    "db:migrate:remote": "wrangler d1 migrations apply checkmyip --remote",
    "test": "node scripts/test-ranges.mjs && node scripts/test-rules.mjs && node scripts/test-sharing.mjs && node scripts/test-seen.mjs && node scripts/stamp-assets.mjs --check",
    "test:ranges": "node scripts/test-ranges.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "test:sharing": "node scripts/test-sharing.mjs",
    "test:seen": "node scripts/test-seen.mjs",
    "bench": "node scripts/bench-ranges.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
